---
import Icon from './Icon.astro';
import { getLang, homeHref, ui } from '@/i18n';

// On sub-pages (case studies, blog) in-page anchors must point back to the home page.
interface Props { home?: boolean }
const { home = true } = Astro.props;
const lang = getLang(Astro.url);
const T = ui(lang);
const h = (hash: string) => (home ? hash : `${homeHref(lang)}${hash}`);
// a small line icon for each link (24x24 paths)
const ICON: Record<string, string> = {
  about: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0',
  skills: 'm8 7-5 5 5 5m8-10 5 5-5 5',
  experience: 'M4 8h16v11H4zM9 8V5h6v3M4 13h16',
  projects: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  cases: 'M5 4h11l3 3v13H5zM9 10h6M9 14h6',
  blog: 'M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4',
  contact: 'M4 6h16v12H4zm0 0 8 7 8-7',
};
const links: [string, string, string][] = [
  [h('#about'), T.nav.about, 'about'], [h('#skills'), T.nav.skills, 'skills'], [h('#experience'), T.nav.experience, 'experience'],
  [h('#projects'), T.nav.projects, 'projects'], ['/case', T.nav.cases, 'cases'], ['/blog', T.nav.blog, 'blog'], [h('#contact'), T.nav.contact, 'contact'],
];
const path = Astro.url.pathname.replace(/\/$/, '');
// no language switch on English pages; the Hindi home page keeps an "English" link back
const other = lang === 'hi' ? { href: '/', lang: 'en' } : { href: '/hi/', lang: 'hi' };
---
<nav style="view-transition-name: site-nav">
  <div class="wrap">
    <a class="logo" href={home ? '#home' : homeHref(lang)} data-hover>DB<span>.</span></a>
    <div class="nav-links">
      {home && <span class="nav-pill" aria-hidden="true"></span>}
      {links.map(([href, label, icon]) => (
        <a href={href} data-hover aria-current={path !== '' && href !== '/' && path.startsWith(href) ? 'page' : undefined}><svg class="nl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICON[icon]} /></svg>{label}</a>
      ))}
    </div>
    <div class="nav-right">
      {home && lang === 'hi' && <a class="lang-switch" href={other.href} hreflang={other.lang} lang={other.lang} title={T.meta.switchTitle} data-hover>{T.meta.switchLabel}</a>}
      <a class="btn ghost resume" href="/resume.pdf" download data-hover style="padding:8px 16px;font-size:14px"><Icon id="i-download" />{T.nav.resume}</a>
      <button class="kbd-hint wide" id="pal-btn" data-hover><span class="sr-only">Search: </span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span id="pal-kbd">Ctrl K</span>
      </button>
      <button class="icon-btn" id="theme-btn" aria-label="Toggle theme" data-hover style="position:relative">
        <Icon id="i-sun" class="sun" /><Icon id="i-moon" class="moon" />
      </button>
      <button class="icon-btn menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><Icon id="i-menu" /></button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    {links.map(([href, label, icon]) => <a href={href}><svg class="nl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICON[icon]} /></svg>{label}</a>)}
    <a href="/resume.pdf" download>{T.nav.downloadResume}</a>
    {home && lang === 'hi' && <a href={other.href} hreflang={other.lang} lang={other.lang}>{T.meta.switchLabel}</a>}
  </div>
</nav>
