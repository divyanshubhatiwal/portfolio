---
import Icon from './Icon.astro';

// On sub-pages (case studies, blog) in-page anchors must point back to the home page.
interface Props { home?: boolean }
const { home = true } = Astro.props;
const h = (hash: string) => (home ? hash : `/${hash}`);
const links: [string, string][] = [
  [h('#about'), 'About'], [h('#skills'), 'Skills'], [h('#experience'), 'Experience'],
  [h('#projects'), 'Projects'], ['/case', 'Case studies'], ['/blog', 'Blog'], [h('#contact'), 'Contact'],
];
const path = Astro.url.pathname.replace(/\/$/, '');
---
<nav style="view-transition-name: site-nav">
  <div class="wrap">
    <a class="logo" href={home ? '#home' : '/'} data-hover>DB<span>.</span></a>
    <div class="nav-links">
      {links.map(([href, label]) => (
        <a href={href} data-hover aria-current={path !== '' && href !== '/' && path.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
    </div>
    <div class="nav-right">
      <a class="btn ghost resume" href="/resume.pdf" download data-hover style="padding:8px 16px;font-size:14px"><Icon id="i-download" />Resume</a>
      <button class="kbd-hint wide" id="pal-btn" aria-label="Open command palette" data-hover>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span id="pal-kbd">Ctrl K</span>
      </button>
      <button class="icon-btn" id="theme-btn" aria-label="Toggle theme" data-hover style="position:relative">
        <Icon id="i-sun" class="sun" /><Icon id="i-moon" class="moon" />
      </button>
      <button class="icon-btn menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><Icon id="i-menu" /></button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
    <a href="/resume.pdf" download>Download Resume</a>
  </div>
</nav>
