---
import { EXPERIENCE } from '@/data/site';
---
<section class="block" id="experience">
  <div class="wrap">
    <div class="eyebrow reveal">03 / Journey</div>
    <h2 class="sec-title reveal">Experience</h2>
    <p class="sec-sub reveal">Where I've been building and what I've shipped.</p>
    <div class="exp reveal">
      <div class="exp-tabs" id="exp-tabs" role="tablist" aria-label="Experience">
        {EXPERIENCE.map((x, i) => (
          <button class:list={['exp-tab', { active: i === 0 }]} role="tab" id={`exp-tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`exp-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-i={i} data-hover>
            <span class="badge">{x.badge}</span>
            <span><b>{x.org}</b><small>{x.period}</small></span>
          </button>
        ))}
      </div>
      <div>
        {EXPERIENCE.map((x, i) => (
          <div class="exp-panel spot" role="tabpanel" id={`exp-panel-${i}`} aria-labelledby={`exp-tab-${i}`} hidden={i !== 0}>
            <h3>{x.role} <span class="org">@ {x.org}</span></h3>
            <div class="meta"><span>{x.period}</span><span>{x.place}</span></div>
            <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
            <div class="tags">{x.tags.map((t) => <span>{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
