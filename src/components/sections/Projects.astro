---
import { content, getLang, ui } from '@/i18n';
import github from '@/data/github.json';

const lang = getLang(Astro.url);
const T = ui(lang).projects;
const { projects, category } = content(lang);
const cats = ['All', ...new Set(projects.map((p) => p.cat))];
const count = (c: string) => (c === 'All' ? projects.length : projects.filter((p) => p.cat === c).length);
const VISIBLE_TAGS = 3;
// first code tour for each project, if it has one
const tourOf = new Map([...github.tours].reverse().map((t) => [t.project, t.slug]));
---
<section class="block" id="projects">
  <div class="wrap">
    <div class="eyebrow reveal">{T.eyebrow}</div>
    <h2 class="sec-title reveal">{T.title}</h2>
    <p class="sec-sub reveal">{T.sub}</p>
    <div class="filters reveal" id="filters" role="group" aria-label={T.filterLabel}>
      {cats.map((c) => (
        <button class:list={['filter', { active: c === 'All' }]} data-f={c} aria-pressed={c === 'All' ? 'true' : 'false'} data-hover>
          {c === 'All' ? T.all : category(c)}<sup>{count(c)}</sup>
        </button>
      ))}
    </div>
    <div class="projects" id="project-grid" data-focus-shown={T.focusShown} data-focus-reset={T.focusReset} data-focus-cv={T.focusCv} data-status-up={T.up} data-status-down={T.down}>
      {projects.map((p, i) => (
        <article class:list={['project', 'spot', 'reveal', { featured: p.featured }]} data-cat={p.cat} data-name={p.name}>
          {p.img && (
            <div class="shot">
              <img src={p.img} alt={`${T.shot} ${p.name}`} loading="lazy" decoding="async" width="900" height="562"
                style={`object-position:${p.imgPos ?? 'center top'}`} />
            </div>
          )}
          <div class="top"><span class="cat">{category(p.cat)}</span><span class="num">/{String(i + 1).padStart(2, '0')}</span></div>
          <h3>{p.name}</h3>
          <p>{p.desc}</p>
          <div class:list={['tags', { collapsed: p.tags.length > VISIBLE_TAGS }]}>
            {p.tags.map((t, j) => <span class:list={{ extra: j >= VISIBLE_TAGS }}>{t}</span>)}
            {p.tags.length > VISIBLE_TAGS && (
              <button type="button" class="more" data-more={`+${p.tags.length - VISIBLE_TAGS}`} aria-expanded="false">+{p.tags.length - VISIBLE_TAGS}</button>
            )}
          </div>
          <div class="links">
            {p.slug && <a href={`/case/${p.slug}`} data-hover>{T.caseStudy}</a>}
            {p.demo && <a href={p.demo} data-hover>{T.tryIt}</a>}
            {tourOf.has(p.name) && <a href={`/tour/${tourOf.get(p.name)}`} data-hover>{T.tour}</a>}
            {p.code && <a href={p.code} target="_blank" rel="noopener noreferrer" data-hover>{T.source}</a>}
            {p.live && <a href={p.live} target="_blank" rel="noopener noreferrer" data-hover>{T.live}</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
