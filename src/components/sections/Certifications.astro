---
import Icon from '../Icon.astro';
import { content, getLang, ui } from '@/i18n';

const lang = getLang(Astro.url);
const T = ui(lang).certs;
const { certs } = content(lang);
---
<section class="block" id="certifications">
  <div class="wrap">
    <div class="eyebrow reveal">{T.eyebrow}</div>
    <h2 class="sec-title reveal">{T.title}</h2>
    <p class="sec-sub reveal">{T.sub}</p>
    <ul class="certs">
      {certs.map((c) => (
        <li class="cert reveal">
          <div class="ico"><Icon id="i-award" /></div>
          <div class="cert-body">
            <h3 lang="en">{c.title}</h3>
            <p class="cert-meta"><span class="issuer">{c.issuer}</span><span class="date">{c.date}</span></p>
            <p class="cert-desc">{c.desc}</p>
          </div>
          {c.url && <a class="cert-link" href={c.url} target="_blank" rel="noopener noreferrer">{T.view}</a>}
        </li>
      ))}
    </ul>
  </div>
</section>