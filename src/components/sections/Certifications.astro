---
import Icon from '../Icon.astro';
import { CERTS } from '@/data/site';
---
<section class="block" id="certifications" style="background: color-mix(in srgb, var(--muted) 30%, transparent)">
  <div class="wrap">
    <div class="eyebrow reveal">06 / Credentials</div>
    <h2 class="sec-title reveal">Certifications</h2>
    <p class="sec-sub reveal">Courses and credentials that back up the work.</p>
    <div class="certs">
      {CERTS.map((c, i) => (
        <div class={`cert spot reveal d${i % 3}`}>
          <div class="ico"><Icon id="i-award" /></div>
          <h3>{c.title}</h3>
          <div class="issuer">{c.issuer}</div>
          <div class="date">{c.date}</div>
          <p>{c.desc}</p>
          {c.url && <a class="btn ghost" href={c.url} target="_blank" rel="noopener noreferrer" data-hover>View Credential ↗</a>}
        </div>
      ))}
    </div>
  </div>
</section>
