---
import Icon from '../Icon.astro';
import { PROJECTS } from '@/data/site';
import { getLang, ui } from '@/i18n';
import type { IconId } from '@/data/site';

const lang = getLang(Astro.url);
const T = ui(lang).about;
const icons: IconId[] = ['i-bot', 'i-layers', 'i-gauge'];
---
<section class="block" id="about">
  <div class="wrap about-grid">
    <div class="about-text">
      <div class="eyebrow reveal">{T.eyebrow}</div>
      <h2 class="sec-title reveal">{T.title}</h2>
      <p class="reveal" set:html={T.p1} />
      <p class="focus reveal"><span>{T.focusLabel}</span>{T.focus}</p>
      <div class="stats reveal">
        <div class="stat"><b data-count={PROJECTS.length}>{PROJECTS.length}</b><span>{T.statProjects}</span></div>
        <div class="stat"><b data-count="3">3</b><span>{T.statPlatforms}</span></div>
        <div class="stat"><b data-count="10" data-suffix="+">10+</b><span>{T.statTech}</span></div>
      </div>
    </div>
    <div class="highlights">
      {T.cards.map(([title, text], i) => (
        <div class={`highlight spot reveal right d${i + 1}`}>
          <div class="ico"><Icon id={icons[i]!} /></div>
          <div><h3>{title}</h3><p>{text}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
