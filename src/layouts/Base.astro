---
import '@/styles/global.css';
import '@/styles/features.css';
import IconSprite from '@/components/IconSprite.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Overlays from '@/components/Overlays.astro';
import { PROFILE } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  /** path under /public, made absolute for link previews */
  image?: string;
  /** home page gets the loader, hero effects and Person structured data */
  home?: boolean;
  type?: 'website' | 'article';
}

const {
  title = `${PROFILE.name} | ${PROFILE.title}`,
  description = 'B.Tech CSE (AI & ML) student and engineer building LLM agents, backend services, full-stack products and mobile apps.',
  image = '/og.png',
  home = false,
  type = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://divyanshu-portfolio.vercel.app');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  jobTitle: PROFILE.title,
  url: site.href,
  email: `mailto:${PROFILE.email}`,
  alumniOf: 'SRM Institute of Science and Technology',
  knowsAbout: ['LLM agents', 'FastAPI', 'Node.js', 'React', 'Machine Learning', 'PostgreSQL'],
  sameAs: [PROFILE.github, PROFILE.linkedin, `https://leetcode.com/u/${PROFILE.leetcodeUser}/`],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={PROFILE.name} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#07070d" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f7f7fc" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title={`${PROFILE.name} | Blog`} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={PROFILE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {home && <script type="application/ld+json" set:html={JSON.stringify(person)} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

  <!-- runs before first paint so the saved theme never flashes the wrong colours -->
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <slot name="head" />
</head>
<body class:list={{ 'is-home': home, loaded: !home }}>
  <a class="skip-link" href="#main">Skip to content</a>
  <IconSprite />
  <Nav home={home} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <Overlays home={home} />

  <script>
    import '@/scripts/main';
  </script>
</body>
</html>
